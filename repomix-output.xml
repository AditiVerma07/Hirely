    },
    applicationDate: {
      type: Date,
      default: Date.now,
    },
    interviewDate: {
      type: Date,
    },
    notes: {
      type: String,
      trim: true,
    },
    followUpReminderSentAt: {
      type: Date,
      default: null,
    },
    interviewReminderSentAt: {
      type: Date,
      default: null,
    },
  },
